generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id              String     @id @default(uuid())
  aadhaar         String     @unique
  verified        Boolean    @default(false)
  verificationId  String?    @unique
  createdAt       DateTime   @default(now())

  consents Consent[]
}

model Consent {
  id         String      @id @default(uuid())
  customerId String
  granted    Boolean
  status     String      @default("Active")
  createdAt  DateTime    @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id])
}


/* In Prisma, customerId is the actual foreign-key column stored in the database. @relation(fields: [customerId], references: [id]) tells Prisma that Token.customerId points to Customer.id. tokens Token[] does not create a column or table; it is a Prisma relation field that lets you navigate from a Customer to all its related Token records using customer.tokens. So, customerId stores the relationship; tokens Token[] lets Prisma access the relationship from the other direction. */