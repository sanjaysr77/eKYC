generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* In Prisma, customerId is the actual foreign-key column stored in the database. @relation(fields: [customerId], references: [id]) tells Prisma that Consent.customerId points to Customer.id. consents Consent[] does not create a column or table; it is a Prisma relation field that lets you navigate from a Customer to all its related Consent records. So, customerId stores the relationship, while consents Consent[] lets Prisma access the related Consent records from the Customer side. */

/* Customer → has many Consent records (one-to-many)
Customer → has many Token records (one-to-many)
Token → belongs to one Consent (many-to-one) */


model Customer {
  id              String     @id @default(uuid())
  aadhaar         String     @unique
  verified        Boolean    @default(false)
  verificationId  String?    @unique
  createdAt       DateTime   @default(now())

  consents Consent[]
  tokens   Token[]
}

model Consent {
  id         String      @id @default(uuid())
  customerId String
  granted    Boolean
  status     String      @default("Active")
  createdAt  DateTime    @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id])

  tokens   Token[]
}

model Token {
  id         String      @id @default(uuid())
  customerId String
  consentId  String
  status     String      @default("Not-Active") 
  createdAt  DateTime    @default(now())
  expiresAt  DateTime

  customer   Customer    @relation(fields:[customerId], references: [id])

  consent    Consent     @relation(fields:[consentId], references: [id])
}


